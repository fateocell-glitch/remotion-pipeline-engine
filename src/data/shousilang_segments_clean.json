[
  {
    "start": 0,
    "end": 2.68,
    "text": "排队三小时 叫号三千多桌"
  },
  {
    "start": 2.68,
    "end": 5.64,
    "text": "一个叫餐名额被黄牛炒到300元"
  },
  {
    "start": 5.64,
    "end": 7.56,
    "text": "寿司郎究竟凭什么火成这样"
  },
  {
    "start": 7.56,
    "end": 9.8,
    "text": "不就是一盘盘转来转去的寿司吗"
  },
  {
    "start": 9.8,
    "end": 12.92,
    "text": "怎么这么多人甘愿排队几小时也要吃"
  },
  {
    "start": 12.92,
    "end": 16.4,
    "text": "曾经旋转寿司是商场餐饮里的弃子"
  },
  {
    "start": 16.4,
    "end": 17.6,
    "text": "闭店率高居不下"
  },
  {
    "start": 17.6,
    "end": 20.48,
    "text": "可就是这样一个看似毫无前景的赛道"
  },
  {
    "start": 20.48,
    "end": 22,
    "text": "寿司郎却逆时突围"
  },
  {
    "start": 22,
    "end": 23.04,
    "text": "进入中国市场后"
  },
  {
    "start": 23.04,
    "end": 24.72,
    "text": "他门店数量连年扩张"
  },
  {
    "start": 24.72,
    "end": 26.32,
    "text": "所到之处必排长队"
  },
  {
    "start": 26.32,
    "end": 28.04,
    "text": "点单攻略 刷屏不断"
  },
  {
    "start": 28.04,
    "end": 29.6,
    "text": "其实寿司郎的爆火"
  },
  {
    "start": 29.6,
    "end": 31.68,
    "text": "核心是踩中了国内日料行业"
  },
  {
    "start": 31.68,
    "end": 33.56,
    "text": "长期存在的供需缺口"
  },
  {
    "start": 33.56,
    "end": 34.56,
    "text": "在他出现之前"
  },
  {
    "start": 34.56,
    "end": 37.08,
    "text": "中国日料市场呈现出两极分化"
  },
  {
    "start": 37.08,
    "end": 38.68,
    "text": "一边是高端日料"
  },
  {
    "start": 38.68,
    "end": 40.48,
    "text": "以omakase为代表"
  },
  {
    "start": 40.48,
    "end": 41.64,
    "text": "人均一千元左右"
  },
  {
    "start": 41.64,
    "end": 43.44,
    "text": "这类门店主打匠人精神"
  },
  {
    "start": 43.44,
    "end": 44.48,
    "text": "吃的是个仪式感"
  },
  {
    "start": 44.48,
    "end": 46.4,
    "text": "更多的是为环境服务"
  },
  {
    "start": 46.4,
    "end": 47.48,
    "text": "所谓的文化买单"
  },
  {
    "start": 47.48,
    "end": 48.8,
    "text": "对普罗大众来说"
  },
  {
    "start": 48.8,
    "end": 49.84,
    "text": "偶尔吃一顿行"
  },
  {
    "start": 49.84,
    "end": 50.84,
    "text": "真要经常吃"
  },
  {
    "start": 50.84,
    "end": 51.88,
    "text": "钱包扛不住啊"
  },
  {
    "start": 51.88,
    "end": 53.64,
    "text": "另一端是低端寿司"
  },
  {
    "start": 53.64,
    "end": 55.12,
    "text": "人均35元以下"
  },
  {
    "start": 55.12,
    "end": 57.08,
    "text": "平价日料门店占比超一半"
  },
  {
    "start": 57.08,
    "end": 58.12,
    "text": "消费者反馈里"
  },
  {
    "start": 58.12,
    "end": 59.6,
    "text": "频繁出现味道差"
  },
  {
    "start": 59.6,
    "end": 60.64,
    "text": "食材不新鲜"
  },
  {
    "start": 60.64,
    "end": 61.44,
    "text": "这类平价"
  },
  {
    "start": 61.44,
    "end": 62.4,
    "text": "高端吃不起"
  },
  {
    "start": 62.4,
    "end": 63.36,
    "text": "低端不敢吃"
  },
  {
    "start": 63.36,
    "end": 65.04,
    "text": "再加上成熟的中端品牌"
  },
  {
    "start": 65.04,
    "end": 65.64,
    "text": "也不多"
  },
  {
    "start": 65.64,
    "end": 67.56,
    "text": "人均一百元以上的门店"
  },
  {
    "start": 67.56,
    "end": 68.84,
    "text": "仅占9.5%"
  },
  {
    "start": 68.84,
    "end": 70.44,
    "text": "这时寿司郎以新鲜"
  },
  {
    "start": 70.44,
    "end": 72.36,
    "text": "高品质相对平价的定位"
  },
  {
    "start": 72.36,
    "end": 73.32,
    "text": "杀进中国市场"
  },
  {
    "start": 73.32,
    "end": 75.08,
    "text": "恰好填补了这一空白"
  },
  {
    "start": 75.08,
    "end": 76.68,
    "text": "如果说踩中大众需求"
  },
  {
    "start": 76.68,
    "end": 77.92,
    "text": "是他爆火的基础"
  },
  {
    "start": 77.92,
    "end": 80,
    "text": "那真正让他把热度延续的"
  },
  {
    "start": 80,
    "end": 82.12,
    "text": "靠的是营销和运营手段"
  },
  {
    "start": 82.12,
    "end": 84.24,
    "text": "不得不说寿司郎很会搞营销"
  },
  {
    "start": 84.24,
    "end": 88.2,
    "text": "推出8元一盘的焦糖鹅肝 10元一盘的三文鱼"
  },
  {
    "start": 88.2,
    "end": 89.76,
    "text": "这些在高端日料店"
  },
  {
    "start": 89.76,
    "end": 91.4,
    "text": "定价上百元的食材"
  },
  {
    "start": 91.4,
    "end": 93.24,
    "text": "在寿司郎被打到平民价"
  },
  {
    "start": 93.24,
    "end": 94.56,
    "text": "光是看到8元焦糖鹅肝"
  },
  {
    "start": 94.56,
    "end": 96.36,
    "text": "有人能忍住不尖叫是什么"
  },
  {
    "start": 96.36,
    "end": 97.24,
    "text": "更关键的是"
  },
  {
    "start": 97.24,
    "end": 99.92,
    "text": "寿司郎还很会持续制造新鲜感"
  },
  {
    "start": 99.92,
    "end": 101.56,
    "text": "几乎每个月都会推新"
  },
  {
    "start": 101.56,
    "end": 103.4,
    "text": "还会声明当月限定"
  },
  {
    "start": 103.4,
    "end": 105.72,
    "text": "无形中催促消费者尽快去打卡"
  },
  {
    "start": 105.72,
    "end": 106.4,
    "text": "过了这村"
  },
  {
    "start": 106.4,
    "end": 107.24,
    "text": "可就没这店了"
  },
  {
    "start": 107.24,
    "end": 108.76,
    "text": "还频繁和Chiikawa"
  },
  {
    "start": 108.76,
    "end": 110.72,
    "text": "还球少年之类的IP做联名"
  },
  {
    "start": 110.72,
    "end": 112.92,
    "text": "在社交平台上自带传播热度"
  },
  {
    "start": 112.92,
    "end": 114.8,
    "text": "热度来了 怎么接住这些客流呢"
  },
  {
    "start": 114.8,
    "end": 116.48,
    "text": "寿司郎可谓是把标准化"
  },
  {
    "start": 116.48,
    "end": 118,
    "text": "流水线做到了极致"
  },
  {
    "start": 118,
    "end": 120.08,
    "text": "首先门店实现高度自助化"
  },
  {
    "start": 120.08,
    "end": 122.68,
    "text": "顾客自助倒水 轨道传送带送餐"
  },
  {
    "start": 122.68,
    "end": 125.52,
    "text": "自助结账 前厅几乎不需要服务员"
  },
  {
    "start": 125.52,
    "end": 126.6,
    "text": "这里最关键的"
  },
  {
    "start": 126.6,
    "end": 128.36,
    "text": "是他那套送餐方式"
  },
  {
    "start": 128.36,
    "end": 129.96,
    "text": "在平板上下单之后"
  },
  {
    "start": 129.96,
    "end": 131.52,
    "text": "系统通过定向轨道"
  },
  {
    "start": 131.52,
    "end": 133.76,
    "text": "直接把点的东西送到你面前"
  },
  {
    "start": 133.76,
    "end": 135.8,
    "text": "点完寿司 纸奔你而来"
  },
  {
    "start": 135.8,
    "end": 137.4,
    "text": "多美好的双向奔赋"
  },
  {
    "start": 137.4,
    "end": 139.08,
    "text": "其次 后厨现代化"
  },
  {
    "start": 139.08,
    "end": 141.64,
    "text": "几乎每一个步骤都有相对应的机器"
  },
  {
    "start": 141.64,
    "end": 143.92,
    "text": "有制作军舰海苔底座的机器"
  },
  {
    "start": 143.92,
    "end": 145.16,
    "text": "有卷手卷的机器"
  },
  {
    "start": 145.16,
    "end": 146.52,
    "text": "甚至还有每小时"
  },
  {
    "start": 146.52,
    "end": 149,
    "text": "可捏制3600份寿司的机器人"
  },
  {
    "start": 149,
    "end": 151.08,
    "text": "同时品牌通过基础食材"
  },
  {
    "start": 151.08,
    "end": 152.08,
    "text": "加不同酱料"
  },
  {
    "start": 152.08,
    "end": 153.2,
    "text": "不同制烤方式"
  },
  {
    "start": 153.2,
    "end": 154.12,
    "text": "把三文鱼"
  },
  {
    "start": 154.12,
    "end": 155.72,
    "text": "金枪鱼等核心食材"
  },
  {
    "start": 155.72,
    "end": 157.12,
    "text": "延伸出多种菜品"
  },
  {
    "start": 157.12,
    "end": 158.6,
    "text": "不仅菜单 丰富多样"
  },
  {
    "start": 158.6,
    "end": 160.04,
    "text": "还简化了供应链"
  },
  {
    "start": 160.04,
    "end": 161.44,
    "text": "降低了备货成本"
  },
  {
    "start": 161.44,
    "end": 162.08,
    "text": "总的来看"
  },
  {
    "start": 162.08,
    "end": 164.44,
    "text": "这种模式带来了惊人的运营数据"
  },
  {
    "start": 164.44,
    "end": 166.32,
    "text": "不仅人力成本被压到极低"
  },
  {
    "start": 166.32,
    "end": 167.32,
    "text": "食材损耗率"
  },
  {
    "start": 167.32,
    "end": 169.72,
    "text": "降到接近0% 顾客等待时间"
  },
  {
    "start": 169.72,
    "end": 171.6,
    "text": "还从5分钟 缩短到3分钟"
  },
  {
    "start": 171.6,
    "end": 172.56,
    "text": "但繁华之下"
  },
  {
    "start": 172.56,
    "end": 174,
    "text": "隐患也同样明显"
  },
  {
    "start": 174,
    "end": 176.36,
    "text": "寿司郎不得不面对一些现实难题"
  },
  {
    "start": 176.36,
    "end": 177.76,
    "text": "排队太久 体验差"
  },
  {
    "start": 177.76,
    "end": 179.4,
    "text": "网红属性逐渐消退后"
  },
  {
    "start": 179.4,
    "end": 181.08,
    "text": "可能导致的翻台率下滑"
  },
  {
    "start": 181.08,
    "end": 182.28,
    "text": "越来越多的竞争者"
  },
  {
    "start": 182.28,
    "end": 184,
    "text": "出现对品牌形成分流等"
  },
  {
    "start": 184,
    "end": 184.52,
    "text": "除此之外"
  },
  {
    "start": 184.52,
    "end": 186.44,
    "text": "寿司郎还有过食品安全问题"
  },
  {
    "start": 186.44,
    "end": 188.48,
    "text": "3月初的舆论风波发酵后"
  },
  {
    "start": 188.48,
    "end": 189.56,
    "text": "其母公司股价"
  },
  {
    "start": 189.56,
    "end": 191.2,
    "text": "一度暴跌近14%"
  },
  {
    "start": 191.2,
    "end": 193.04,
    "text": "食品安全是餐饮的生命线"
  },
  {
    "start": 193.04,
    "end": 195.28,
    "text": "一次翻车就可能动摇所有口碑"
  },
  {
    "start": 195.28,
    "end": 199.24,
    "text": "此时 同样来自日本的大新连锁回转寿司 滨寿司"
  },
  {
    "start": 199.24,
    "end": 200.48,
    "text": "计划在未来3年内"
  },
  {
    "start": 200.48,
    "end": 202.96,
    "text": "把位于中国内地市场的门店数量翻倍"
  },
  {
    "start": 202.96,
    "end": 203.6,
    "text": "更不用说"
  },
  {
    "start": 203.6,
    "end": 206,
    "text": "包括海底捞在内的本土餐饮品牌"
  },
  {
    "start": 206,
    "end": 207.32,
    "text": "也在以跨界的方式"
  },
  {
    "start": 207.32,
    "end": 208.88,
    "text": "涌入寿司这一赛道"
  },
  {
    "start": 208.88,
    "end": 211.2,
    "text": "随着中端寿司市场的竞争白热化"
  },
  {
    "start": 211.2,
    "end": 213.2,
    "text": "各大连锁品牌之间的差异化"
  },
  {
    "start": 213.2,
    "end": 215,
    "text": "似乎正在被逐渐抹平"
  },
  {
    "start": 215,
    "end": 215.8,
    "text": "这些问题"
  },
  {
    "start": 215.8,
    "end": 218,
    "text": "如果寿司郎不能从根本上解决"
  },
  {
    "start": 218,
    "end": 219.96,
    "text": "并持续做出改变和升级"
  },
  {
    "start": 219.96,
    "end": 225.44,
    "text": "如今排队数小时和叫号上千桌的盛况"
  },
  {
    "start": 225.44,
    "end": 226.24,
    "text": "最后想问一下"
  },
  {
    "start": 226.24,
    "end": 227.72,
    "text": "大家吃过寿司郎吗"
  },
  {
    "start": 227.72,
    "end": 230.96,
    "text": "为寿司郎排过最长的队是多久"
  }
]