{
  "compilerOptions": {
    "target": "ES2018",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "lib": ["es2015", "dom"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/**/*",
    "templates/animated-text.tsx",
    "templates/chart-animation.tsx",
    "templates/grid-pulse.tsx",
    "templates/lower-third.tsx",
    "templates/matrix-rain.tsx",
    "templates/stat-counter.tsx"
  ],
  "exclude": ["remotion.config.ts"]
}
